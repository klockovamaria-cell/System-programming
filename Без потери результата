// Класс для сравнения (не используем в работе)
// Он показывает, что volatile не спасает от потери данных.
class Counter{
    private volatile long counter = 0; // Гарантирует только видимость данных
    long getCounter() {
        return counter;
    }
    void increment() {
        counter++;
    }
}
// Главный класс, где живет вся логика
public static class InterferenceExample {
    private static final int HUNDRED_MILLION = 100000000; // Наша цель
    // Светофор для остановки потоков
    private final AtomicInteger stopSignal = new AtomicInteger();
    // Главный счетчик. Он потокобезопасный — данные не теряются
    private final AtomicInteger safeCounter = new AtomicInteger();
    // Проверяем, пора ли останавливаться
    boolean stop(){
        return stopSignal.incrementAndGet() > HUNDRED_MILLION;
    }
    // Прибавляем 1 к главному счетчику. Операция атомарная
    void incrementSafeCounter() {
        safeCounter.incrementAndGet();
    }
    // Просто отдаем число для вывода на экран
    int getSafeCounter() {
        return safeCounter.get();
    }
    // Основная программа
    void example() throws InterruptedException {
        // Создаем два потока
        InterferenceThread thread1 = new InterferenceThread(this);
        InterferenceThread thread2 = new InterferenceThread(this);
        long startTime = System.currentTimeMillis(); // Засекаем старт
        thread1.start(); // Запускаем первый поток
        thread2.start(); // Запускаем второй поток
        // Ждем, пока оба потока закончат работу
        thread1.join();
        thread2.join();
        long endTime = System.currentTimeMillis(); // Засекаем финиш
        System.out.println("Ожидание (цель): " + HUNDRED_MILLION);
        System.out.println("Потрачено времени: " + (endTime - startTime) + " мс");
        // Так как счетчик атомарный, потерь нет
        System.out.println("Результат (счетчик без потерь): " + getSafeCounter());
        System.out.println("Потеряно инкрементов: " + (HUNDRED_MILLION - getSafeCounter()));
    }
}
// Описание одного потока
public static class InterferenceThread extends Thread {
    private final InterferenceExample checker; // Ссылка на данные
    InterferenceThread(InterferenceExample checker) {
        this.checker = checker;
    }
    // То, что делает поток после запуска
    @Override
    public void run() {
        // Крутимся в цикле, пока светофор не скажет стоп
        while (!checker.stop()) {
            // Прибавляем единицу к общему счетчику
            checker.incrementSafeCounter();
        }
    }
}
// Точка входа
static void main(String[] args) throws InterruptedException {
    new InterferenceExample().example();
}
