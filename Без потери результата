// Класс для примера (в работе не участвует)
class Counter {
    private volatile long counter = 0;
    long getCounter() {
        return counter;
    }
    void increment() {
        counter++; // Здесь будут потери данных!
    }
}
public class Main {
    private static final int HUNDRED_MILLION = 100000000; // Цель: 100000000
    private int stopSignal = 0; // Счетчик для остановки потоков
    private int safeCounter = 0; // Главный счетчик
    private final Object lock = new Object(); // Замок для синхронизации
    // Проверка: достигли ли мы 100000000?
    boolean stop() {
        synchronized (lock) { // Берем замок
            return ++stopSignal > HUNDRED_MILLION;
        } // Отдаем замок
    }
    // Безопасное прибавление +1
    void incrementSafeCounter() {
        synchronized (lock) { // Берем замок
            safeCounter++;
        } // Отдаем замок
    }
    // Безопасное чтение счетчика
    int getSafeCounter() {
        synchronized (lock) { // Берем замок
            return safeCounter;
        } // Отдаем замок
    }
    void example() throws InterruptedException {
        // Создаем два потока
        InterferenceThread thread1 = new InterferenceThread(this);
        InterferenceThread thread2 = new InterferenceThread(this);
        long startTime = System.currentTimeMillis(); // Засекаем время
        thread1.start(); // Запускаем поток 1
        thread2.start(); // Запускаем поток 2
        thread1.join(); // Ждем поток 1
        thread2.join(); // Ждем поток 2
        long endTime = System.currentTimeMillis(); // Засекаем время
        System.out.println("Ожидание (цель): " + HUNDRED_MILLION);
        System.out.println("Потрачено времени: " + (endTime - startTime) + " мс");
        System.out.println("Результат (счетчик без потерь): " + getSafeCounter());
        System.out.println("Потеряно инкрементов: " + (HUNDRED_MILLION - getSafeCounter()));
    }
    // Сам поток (работник)
    public static class InterferenceThread extends Thread {
        private final Main checker;
        InterferenceThread(Main checker) {
            this.checker = checker;
        }
        @Override
        public void run() {
            // Крутимся, пока не наберем 100 млн
            while (!checker.stop()) {
                checker.incrementSafeCounter();
            }
        }
    }
    public static void main(String[] args) throws InterruptedException {
        new Main().example(); // Запуск программы
    }
}
