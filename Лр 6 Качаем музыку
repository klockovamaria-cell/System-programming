import java.io.*;
import java.net.URL; // Для работы с интернет-адресами (URL)
import java.nio.file.Files; // Работа с файлами на диске
import java.nio.file.Path;
import java.util.Scanner; // Ввод данных от пользователя
public class Main {
    private static final String SONG_1_URL = "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3"; // Ссылка на первую песню
    private static final String SONG_2_URL = "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-8.mp3"; // На вторую песню
    private static final String SONG_3_URL = "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-9.mp3"; // На третью песню
    private static final String SONG_4_URL = "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-7.mp3"; // На четвёртую песню
    private static final Path FOLDER_PATH = Path.of("music"); // Папка, куда будут сохраняться файлы
    public static void main(String[] args) throws IOException { // Точка входа программы
        Scanner scanner = new Scanner(System.in); // Создаём объект для чтения ввода пользователя
        System.out.println("Выберите один из вариантов:"); // Меню выбора треков
        System.out.println("1 - Первая песня");
        System.out.println("2 - Вторая песня");
        System.out.println("3 - Третья песня");
        System.out.println("4 - Четвёртая песня");
        System.out.println("5 - Ввести свою прямую ссылку");
        int choice = scanner.nextInt(); // Читаем выбор пользователя
        scanner.nextLine(); // Убираем символ переноса строки после nextInt()
        switch (choice) { // Обрабатываем выбор
            case 1 -> download(SONG_1_URL, "song1.mp3");
            case 2 -> download(SONG_2_URL, "song2.mp3");
            case 3 -> download(SONG_3_URL, "song3.mp3");
            case 4 -> download(SONG_4_URL, "song4.mp3");
            case 5 -> manualDownload(scanner);
            default -> System.err.println("Ошибка: неверный выбор.");
        }
    }
    //Универсальный метод скачивания файла по прямой ссылке
    private static void download(String urlStr, String fileName) throws IOException {
        Files.createDirectories(FOLDER_PATH); // Проверяем наличие папки music и создаём её, если нет
        URL url = new URL(urlStr);
        try (
                InputStream in = url.openStream(); // Поток для чтения данных из интернета
                OutputStream out = Files.newOutputStream(FOLDER_PATH.resolve(fileName)) // Поток для записи в файл
        ) {
            byte[] buffer = new byte[8192]; // Буфер для быстрого чтения
            int bytesRead;
            while ((bytesRead = in.read(buffer)) != -1) { // Читаем порциями до конца файла
                out.write(buffer, 0, bytesRead); // Записываем данные в файл
            }
            System.out.println("Файл успешно сохранён в папке music: " + fileName);
        } catch (IOException e) {
            System.err.println("Ошибка при загрузке: " + e.getMessage()); // Сообщение об ошибке
        }
    }

    // Скачивание по ссылке пользователя
    private static void manualDownload(Scanner scanner) throws IOException {
        System.out.print("Введите прямую ссылку на музыкальный файл (.mp3): ");
        String url = scanner.nextLine().trim(); // Получили ссылку
        if (url.isEmpty()) { // Защита от пустой ссылки
            System.err.println("Ссылка не может быть пустой!");
            return;
        }
        // Берём имя файла прямо из ссылки (всё, что идёт после последнего слэша).
        String fileName = url.substring(url.lastIndexOf('/') + 1);
        download(url, fileName); // Запускаем основной метод скачивания
    }
}
