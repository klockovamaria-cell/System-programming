public class Main {

    // Общий объект для синхронизации потоков
    private static final Object lock = new Object();

    // Если true — очередь курицы
    // Если false — очередь яйца
    private static boolean chickenTurn = true;

    // Последнее произнесённое слово
    private static String lastWord = "";

    public static void main(String[] args) throws InterruptedException {

        // Поток, который выводит слово «Курица»
        Thread chickenThread = new Thread(() -> {

            // Курица должна сказать слово 5 раз
            for (int i = 0; i < 5; i++) {

                // Захватываем объект блокировки
                synchronized (lock) {

                    // Если сейчас очередь яйца, курица ждёт
                    while (!chickenTurn) {
                        try {
                            lock.wait();
                        } catch (InterruptedException e) {
                            // Восстанавливаем статус прерывания потока
                            Thread.currentThread().interrupt();

                            // Завершаем работу потока
                            return;
                        }
                    }

                    // Выводим слово курицы
                    System.out.println("Курица");

                    // Запоминаем последнее слово
                    lastWord = "Курица";

                    // Передаём очередь яйцу
                    chickenTurn = false;

                    // Уведомляем ожидающий поток
                    lock.notifyAll();
                }
            }
        });

        // Поток, который выводит слово «Яйцо»
        Thread eggThread = new Thread(() -> {

            // Яйцо должно сказать слово 5 раз
            for (int i = 0; i < 5; i++) {

                // Захватываем объект блокировки
                synchronized (lock) {

                    // Если сейчас очередь курицы, яйцо ждёт
                    while (chickenTurn) {
                        try {
                            lock.wait();
                        } catch (InterruptedException e) {
                            // Восстанавливаем статус прерывания потока
                            Thread.currentThread().interrupt();

                            // Завершаем работу потока
                            return;
                        }
                    }

                    // Выводим слово яйца
                    System.out.println("Яйцо");

                    // Запоминаем последнее слово
                    lastWord = "Яйцо";

                    // Передаём очередь курице
                    chickenTurn = true;

                    // Уведомляем ожидающий поток
                    lock.notifyAll();
                }
            }
        });

        // Запускаем поток курицы
        chickenThread.start();

        // Запускаем поток яйца
        eggThread.start();

        // Ожидаем завершения потока курицы
        chickenThread.join();

        // Ожидаем завершения потока яйца
        eggThread.join();

        // Проверяем, что оба потока завершили работу
        if (!chickenThread.isAlive() && !eggThread.isAlive()) {
            System.out.println();
            System.out.println("Спор окончен.");
            System.out.println("Последним сказало: " + lastWord);
        }
    }
}
